# Flask Configuration
FLASK_ENV=development
DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8080

# File Upload Settings
UPLOAD_FOLDER=static/uploads
BASE_FOLDER=databaru/
MODEL_FOLDER=model/
ALLOWED_EXTENSIONS=jpg,jpeg,png
MAX_CONTENT_LENGTH=16777216  # 16MB

# Face Recognition Settings
FACE_DETECTION_MODEL=retinaface
FACE_RECOGNITION_MODEL=Facenet512
FACE_IMAGE_SIZE=250

# Security
JWT_SECRET_KEY=""
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour

# Embeddings
EMBEDDINGS_PATH=model/ds_model_face_new.h5

DB_USER=""
DB_PASSWORD=""
DB_HOST=""
DB_NAME=""

POSTGRES_HOST=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_PORT=""
